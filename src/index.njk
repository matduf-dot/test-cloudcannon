          <button class="nav-bouton" aria-expanded="false" aria-controls="sm-entreprendre">Entreprendre <svg viewBox="0 0 12 8" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><path d="M1 1l5 5 5-5"/></svg></button>
