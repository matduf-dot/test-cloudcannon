            <li><a href="#">Espace France Services</a></li>
          </ul>
        </li>
        <li class="nav-item">
          <button class="nav-bouton" aria-expanded="false" aria-controls="sm-familles">Enfance et familles <svg viewBox="0 0 12 8" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><path d="M1 1l5 5 5-5"/></svg></button>
