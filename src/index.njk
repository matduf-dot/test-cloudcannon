<main id="contenu" tabindex="-1">

  <section class="bandeau" aria-labelledby="titre-page">
    <div class="conteneur">
      <div>
        <h1 id="titre-page" data-editable="text" data-prop="titre_principal" data-type="span">{{ titre_principal }}</h1>
        <p class="bandeau-intro" data-editable="text" data-prop="intro" data-type="text">{{ intro | safe }}</p>
        <form class="recherche" role="search" action="#" data-recherche>
          <label for="recherche-site">Que cherchez-vous ?</label>
          <div class="recherche-ligne">
            <input id="recherche-site" name="q" type="search" autocomplete="off" placeholder="Collecte des déchets, horaires de la piscine…">
            <button class="bouton-plein" type="submit">Rechercher</button>
          </div>
          <p class="recherche-message" aria-live="polite"></p>
        </form>
        <ul class="suggestions" aria-label="Recherches fréquentes">
          <li><a href="#demarches">Collecte des déchets</a></li>
          <li><a href="#demarches">Horaires de la piscine</a></li>
          <li><a href="#demarches">Inscription accueil de loisirs</a></li>
        </ul>
      </div>
      <div class="bandeau-visuel">
        <div class="visuel-compo">

          <svg class="visuel-calque" viewBox="0 0 600 400" aria-hidden="true" focusable="false" preserveAspectRatio="none">
            <path d="M0 0H100V100A100 100 0 0 1 0 0Z" fill="#2d7c7f"/>
            <path d="M100 100V200H0A100 100 0 0 1 100 100Z" fill="#b2ab29"/>
            <path d="M0 200H100A100 100 0 0 1 0 300Z" fill="#e6272d"/>
            <path d="M0 300A100 100 0 0 1 100 400H0Z" fill="#b3c89f"/>
            <path d="M500 0V100A100 100 0 0 1 400 0Z" fill="#e6272d"/>
            <path d="M600 0V100H500A100 100 0 0 1 600 0Z" fill="#b2ab29"/>
            <path d="M400 400V300A100 100 0 0 1 500 400Z" fill="#2d7c7f"/>
            <path d="M500 300H600V400A100 100 0 0 1 500 300Z" fill="#36b094"/>
            <path d="M500 400a50 50 0 0 1 100 0Z" fill="#b3c89f"/>
          </svg>

          <!-- Photo 1 : l'arche. Vraie balise <img>, forme d'arche appliquee en CSS (clip-path). -->
          <img class="visuel-arche" src="{{ image_bandeau }}" alt="{{ image_bandeau_alt }}"
               data-editable="image" data-prop-src="image_bandeau" data-prop-alt="image_bandeau_alt">

          <svg class="visuel-calque" viewBox="0 0 600 400" aria-hidden="true" focusable="false" preserveAspectRatio="none">
            <circle cx="445" cy="200" r="90" fill="#b3c89f"/>
          </svg>

          <img class="visuel-rond" src="/images/bandeau-rond.webp" alt="" loading="lazy" decoding="async">

          <svg class="visuel-calque" viewBox="0 0 600 400" aria-hidden="true" focusable="false" preserveAspectRatio="none">
            <path d="M100 400V330A70 70 0 0 1 170 400Z" fill="#36b094" style="mix-blend-mode:multiply"/>
            <path d="M400 0A80 80 0 0 1 320 80V0Z" fill="#b2ab29" style="mix-blend-mode:multiply"/>
            <path d="M400 400V300A100 100 0 0 0 300 400Z" fill="#e6272d"/>
            <circle cx="57.6" cy="42.4" r="11" fill="#f7f5ef"/>
            <circle cx="57.6" cy="157.6" r="11" fill="#16393a"/>
            <circle cx="42.4" cy="242.4" r="11" fill="#f7f5ef"/>
            <circle cx="42.4" cy="357.6" r="11" fill="#2d7c7f"/>
            <circle cx="457.6" cy="42.4" r="11" fill="#b3c89f"/>
            <circle cx="557.6" cy="57.6" r="11" fill="#16393a"/>
            <circle cx="442.4" cy="357.6" r="11" fill="#b2ab29"/>
            <circle cx="357.6" cy="357.6" r="11" fill="#f7f5ef"/>
            <circle cx="550.0" cy="378.8" r="11" fill="#2d7c7f"/>
          </svg>

          <!-- Masques CSS : reprennent exactement les clipPath de la maquette d'origine. -->
          <svg class="visuel-masques" aria-hidden="true" focusable="false" width="0" height="0">
            <defs>
              <clipPath id="masque-arche" clipPathUnits="objectBoundingBox">
                <path d="M0,1 V0.375 A0.5,0.375 0 0 1 1,0.375 V1 Z"/>
              </clipPath>
              <clipPath id="masque-dome" clipPathUnits="objectBoundingBox">
                <path d="M0,1 V0.7142857 A0.5,0.7142857 0 0 1 1,0.7142857 V1 Z"/>
              </clipPath>
            </defs>
          </svg>

        </div>
      </div>
    </div>
  </section>

  <section class="demarches" id="demarches" aria-labelledby="titre-demarches">
    <div class="conteneur">
      <div class="entete-section">
        <div>
          <p class="surtitre">Accès rapides</p>
          <h2 class="titre-section" id="titre-demarches">Les démarches les plus demandées</h2>
        </div>
        <a class="lien-fort" href="#">Toutes les démarches <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><path d="M4 12h15M13 6l6 6-6 6"/></svg></a>
      </div>

      <div class="bento">
        <span class="coin" style="left:-4px;top:-4px" aria-hidden="true"></span>
        <span class="coin" style="right:-3px;top:-4px" aria-hidden="true"></span>
        <span class="coin" style="right:-3px;bottom:-3px" aria-hidden="true"></span>

        <span class="filet-r1" aria-hidden="true"></span>
        <article class="case case--grande c-collecte fond-olive">
          <span class="pastille"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><rect x="3" y="5" width="18" height="3" rx=".5"/><rect x="9" y="2.5" width="6" height="2.5"/><path d="M5 9h14l-1.6 12.5H6.6z"/><circle cx="12" cy="15" r="2.2" fill="var(--fond-pastille)"/></svg></span>
          <div><h3><a href="#">Collecte et déchèteries</a></h3><p>Jours de collecte par commune, horaires des déchèteries, encombrants.</p></div>
        </article>
        <div class="case-vide v-1"><img src="{{ image_grille }}" alt="{{ image_grille_alt }}" loading="lazy" decoding="async" style="object-position:42% 50%" data-editable="image" data-prop-src="image_grille" data-prop-alt="image_grille_alt"><svg viewBox="0 0 40 40" aria-hidden="true" style="right:0;bottom:0"><path d="M40 0A40 40 0 0 0 0 40H40Z" fill="#b3c89f"/></svg></div>
        <article class="case case--grande c-aqua fond-petrole">
          <span class="pastille"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M1.5 8a3.6 3.6 0 0 1 5.25 0 3.6 3.6 0 0 0 5.25 0 3.6 3.6 0 0 1 5.25 0 3.6 3.6 0 0 0 5.25 0v4.4a3.6 3.6 0 0 1-5.25 0 3.6 3.6 0 0 0-5.25 0 3.6 3.6 0 0 1-5.25 0 3.6 3.6 0 0 0-5.25 0z"/><path d="M1.5 15.4a3.6 3.6 0 0 1 5.25 0 3.6 3.6 0 0 0 5.25 0 3.6 3.6 0 0 1 5.25 0 3.6 3.6 0 0 0 5.25 0v4.4a3.6 3.6 0 0 1-5.25 0 3.6 3.6 0 0 0-5.25 0 3.6 3.6 0 0 1-5.25 0 3.6 3.6 0 0 0-5.25 0z"/></svg></span>
          <div>
            <h3><a href="#">Centre aquatique</a></h3>
            <p>Horaires, tarifs et activités de la semaine.</p>
            <div class="horaires">
              <ul class="horaires-liste" data-editable="array" data-prop="horaires" data-direction="column">
                {%- for ligne in horaires %}
                <li data-editable="array-item">
                  <span class="horaires-jour" data-editable="text" data-prop="jour" data-type="span">{{ ligne.jour }}</span>
                  <span class="horaires-heures" data-editable="text" data-prop="heures" data-type="span">{{ ligne.heures }}</span>
                </li>
                {%- endfor %}
              </ul>
              <a href="#">Voir les horaires de la semaine</a>
            </div>
          </div>
        </article>
        <article class="case c-loisirs fond-rouge">
          <span class="pastille"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><circle cx="7.5" cy="5.5" r="3"/><circle cx="16.5" cy="7.5" r="2.6"/><path d="M2.5 21v-6a5 5 0 0 1 10 0v6z"/><path d="M12.5 21v-4.5a4 4 0 0 1 8 0V21z"/></svg></span>
          <div><h3><a href="#">Accueils de loisirs</a></h3><p>Inscriptions et périscolaire.</p></div>
        </article>
        <article class="case c-spanc fond-eau">
          <span class="pastille"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M12 2 5.5 13h13z"/><circle cx="12" cy="15" r="6.5"/></svg></span>
          <div><h3><a href="#">Assainissement</a></h3><p>SPANC et contrôles.</p></div>
        </article>
        <article class="case c-bases fond-clair">
          <span class="pastille"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><circle cx="17" cy="6" r="3.5"/><path d="M1 21 9 7l8 14z"/><path d="M11 21l5-8 6 8z"/></svg></span>
          <div><h3><a href="#">Bases de loisirs</a></h3><p>Baignade et activités d'été.</p></div>
        </article>
        <div class="case-vide v-2" aria-hidden="true"><!-- PHOTO : concert, site cctdm.fr, crédit à confirmer --><img src="/images/bento-concert.webp" alt="" loading="lazy" decoding="async" style="object-position:50% 50%"><svg viewBox="0 0 40 40" aria-hidden="true" style="right:0;bottom:0"><path d="M40 0A40 40 0 0 0 0 40H40Z" fill="#b3c89f"/></svg></div>
        <article class="case case--petite c-habitat fond-petrole">
          <span class="pastille"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M12 2 2 11h20z"/><path d="M4 11h16v10H4z"/><path d="M9.5 21v-4a2.5 2.5 0 0 1 5 0v4z" fill="var(--fond-pastille)"/></svg></span>
          <h3><a href="#">Habitat et urbanisme</a></h3>
        </article>
        <article class="case case--petite c-emploi fond-olive">
          <span class="pastille"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M8 7V5a4 4 0 0 1 8 0v2h-2.2V5a1.8 1.8 0 0 0-3.6 0v2z"/><rect x="2" y="7" width="20" height="14" rx="1"/><rect x="2" y="12" width="20" height="2" fill="var(--fond-pastille)"/></svg></span>
          <h3><a href="#">Offres d'emploi</a></h3>
        </article>
        <article class="case case--petite c-delib fond-rouge">
          <span class="pastille"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M4 2h11l5 5v15H4z"/><path d="M15 2v5h5z" fill="var(--fond-pastille)"/><rect x="7" y="11" width="10" height="1.8" fill="var(--fond-pastille)"/><rect x="7" y="15" width="7" height="1.8" fill="var(--fond-pastille)"/></svg></span>
          <h3><a href="#">Délibérations</a></h3>
        </article>
      </div>
    </div>
  </section>

  <section class="actus" aria-labelledby="titre-actus">
    <div class="conteneur">
      <div class="entete-section">
        <div>
          <p class="surtitre">Actualités</p>
          <h2 class="titre-section" id="titre-actus">Ce qui se passe sur le territoire<span class="frise" aria-hidden="true"><svg viewBox="0 0 40 40" aria-hidden="true" focusable="false"><path d="M0 0a40 40 0 0 1 40 40H0z" fill="#b2ab29"/></svg><svg viewBox="0 0 40 40" aria-hidden="true" focusable="false"><rect width="40" height="40" fill="#2d7c7f"/></svg><svg viewBox="0 0 40 40" aria-hidden="true" focusable="false"><path d="M0 40a20 20 0 0 1 40 0z" fill="#e6272d"/></svg><svg viewBox="0 0 40 40" aria-hidden="true" focusable="false"><path d="M20 8 38 40H2z" fill="#36b094"/></svg><svg viewBox="0 0 40 40" aria-hidden="true" focusable="false"><circle cx="20" cy="22" r="18" fill="#b3c89f"/></svg></span></h2>
        </div>
        <a class="lien-fort" href="#">Toutes les actualités <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><path d="M4 12h15M13 6l6 6-6 6"/></svg></a>
      </div>

      <!-- Les 3 cartes viennent de la cle "actualites" du front matter.
           Les attributs de tableau donnent a l'equipe
           l'ajout, la suppression et le glisser-deposer dans l'editeur visuel. -->
      <ul class="actus-grille" data-editable="array" data-prop="actualites" data-direction="row">
        {%- for actu in actualites %}
        <li class="actu actu--carte" data-editable="array-item">
          <div class="actu-visuel">
            <img src="{{ actu.image }}" alt="{{ actu.image_alt }}" loading="lazy" decoding="async"
                 data-editable="image" data-prop-src="image" data-prop-alt="image_alt">
          </div>
          <p class="meta">
            <span class="etiquette {{ actu.etiquette_couleur }}" data-editable="text" data-prop="etiquette" data-type="span">{{ actu.etiquette }}</span>
            <time datetime="{{ actu.date | dateIso }}">{{ actu.date | dateFr }}</time>
          </p>
          <h3><a href="#" data-editable="text" data-prop="titre" data-type="span">{{ actu.titre }}</a></h3>
          <p class="accroche" data-editable="text" data-prop="texte" data-type="text">{{ actu.texte | safe }}</p>
        </li>
        {%- endfor %}
      </ul>
    </div>
  </section>

  <section class="agenda" aria-labelledby="titre-agenda">
    <div class="conteneur">
      <div class="entete-section">
        <div>
          <p class="surtitre">Agenda du territoire</p>
          <h2 class="titre-section" id="titre-agenda">Les sorties près de chez vous</h2>
        </div>
        <a class="lien-fort" href="#">Tout l'agenda <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><path d="M4 12h15M13 6l6 6-6 6"/></svg></a>
      </div>

      <div class="filtres">
        <div class="champ-select">
          <label for="filtre-commune">Commune</label>
          <select id="filtre-commune" data-filtre-commune>
            <option value="">Toutes les communes</option>
